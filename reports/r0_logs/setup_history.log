def snapshot(p):
 return {str(f.relative_to(p)):hashlib.sha256(f.read_bytes()).hexdigest() for f in p.rglob("*") if f.is_file()} if p.is_dir() else hashlib.sha256(p.read_bytes()).hexdigest()
for src,dst in pairs:
 assert (r/src).exists(),src
 assert not (r/dst).exists(),dst
before={src:snapshot(r/src) for src,dst in pairs}; task_before=snapshot(r/"codex任务文件夹")
for src,dst in pairs:
 (r/dst).parent.mkdir(parents=True,exist_ok=True); (r/src).rename(r/dst); assert snapshot(r/dst)==before[src]; print("MOVED",src,"->",dst,"; contents verified unchanged")
assert snapshot(r/"codex任务文件夹")==task_before
for repo in ("THIS","Su-AdaptiveLASSO"):
 status=subprocess.check_output(["git","-C",str(r/"upstream"/repo),"status","--porcelain"],text=True); assert not status; print("UPSTREAM_CLEAN",repo)
print("TASK_FILES_UNCHANGED")'
